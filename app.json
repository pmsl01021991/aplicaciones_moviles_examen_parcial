{
  "expo": {
    "name": "Restaurante el buen sabor",
    "slug": "examen_parcial",
    "icon": "./assets/images/chef-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "examenpreliminar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pablo20261991.restaurantebuensabor",
      "adaptiveIcon": {

        "foregroundImage": "./assets/images/chef-icon.png",

        "backgroundColor": "#F97316"

      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "019da381-0c69-417f-b1b4-90e2add85ed1"
      }
    }
  }
}
